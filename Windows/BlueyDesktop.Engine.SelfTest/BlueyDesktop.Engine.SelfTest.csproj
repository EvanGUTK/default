<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console checks for the Engine folder. It compiles the Engine sources directly, so it sees the internals. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>BlueyDesktop.Engine.SelfTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlueyDesktop.Core\BlueyDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BlueyDesktop.App\Engine\**\*.cs" Link="Engine\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
